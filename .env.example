# ---------------------------------------------------------------------------
# Hadfield Inquiry Planner — environment configuration
# Copy this file to `.env.local` and fill in your own values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
# Get these from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://zcslgqitzkmxwusrqlsu.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---------------------------------------------------------------------------
# AI (Groq) — key stays server-side only
# ---------------------------------------------------------------------------
# IMPORTANT: never put a real Groq key in a VITE_ variable. Anything prefixed
# with VITE_ is bundled into the client and is publicly readable.
#
# The Groq key lives ONLY in the Supabase Edge Function secret store:
#   supabase secrets set GROQ_API_KEY=gsk_...
#
# Optional: override the Edge Function name if you rename it.
VITE_CHAT_FUNCTION=chat

# ---------------------------------------------------------------------------
# Direct Groq fallback (no Supabase yet)
# ---------------------------------------------------------------------------
# While Supabase is NOT configured, you can let the app talk to Groq straight
# from the browser. Put the key in `.env.local` (git-ignored) as:
#   VITE_GROQ_API_KEY=gsk_...
# Once VITE_SUPABASE_URL/ANON_KEY are set, this key is ignored by the app and
# can be removed — the Edge Function path takes priority so the key stays
# server-side. Use a restricted/rotating key if you ship this publicly.

# Models are hard-pinned in code (cheapest verified set on your account):
#   chat:        openai/gpt-oss-20b       (src/services/ai.ts → AI_MODELS.chat)
#   transcribe:  whisper-large-v3-turbo   (Edge Function TRANSCRIBE_MODEL)
# The Edge Function allow-lists chat models, so a wrong value here can never
# cause an unexpected 400 or a pricier model being billed.
# VITE_AI_MODEL=openai/gpt-oss-20b
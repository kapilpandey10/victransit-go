# ---------------------------------------------------------------------------
# Hadfield Inquiry Planner — environment configuration
# Copy this file to `.env.local` and fill in your own values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
# Get these from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---------------------------------------------------------------------------
# AI (Groq)
# ---------------------------------------------------------------------------
# IMPORTANT: never put a real Groq key in a VITE_ variable. Anything prefixed
# with VITE_ is bundled into the client and is publicly readable.
#
# The Groq key lives ONLY in the Supabase Edge Function secret store:
#   supabase secrets set GROQ_API_KEY=your-key
#
# Optional: override the Edge Function name if you rename it.
VITE_CHAT_FUNCTION=chat

# Optional: model used by the Edge Functions (server-side default: openai/gpt-oss-20b)
# VITE_AI_MODEL=openai/gpt-oss-120b